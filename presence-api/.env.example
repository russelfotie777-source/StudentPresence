APP_NAME="Présence API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=presence_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push (rappels de pointage) : générer avec `php artisan webpush:vapid`
VAPID_SUBJECT=mailto:infos.iut@univ-douala.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Assistant IA du back-office (https://console.anthropic.com) — laisser vide pour désactiver
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Taille maximale d'une pièce jointe envoyée à l'assistant, en Mo.
# À accompagner côté serveur, sinon le fichier est refusé avant d'arriver :
#   php.ini   : upload_max_filesize = 30M, post_max_size = 30M, max_execution_time = 0 (CLI)
#   nginx     : client_max_body_size 30M;
# Les imports tournent en file d'attente : `php artisan queue:work --queue=assistant`
# (avec --timeout=3600 : un PDF de deux cents pages se lit en plusieurs minutes).
ASSISTANT_TAILLE_MAX_FICHIER_MO=25
